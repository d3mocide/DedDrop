# Copy to .env and fill in. Never commit the real .env (contains your API key).

# Your tar1090 aircraft.json feed. Common defaults:
#   sdr-enthusiasts/docker-tar1090 container:  http://<host>:8080/data/aircraft.json
#   wiedehopf native tar1090 install:          http://<host>/tar1090/data/aircraft.json
TAR1090_URL=http://192.168.1.50/tar1090/data/aircraft.json

# Generate this in your WDGWars profile (wdgwars.pl) -> API key. 64-char hex.
WDGWARS_API_KEY=

# Optional: Separate API key for MeshMapper wardrive ingest (defaults to WDGWARS_API_KEY if unset)
MESHMAPPER_API_KEY=

# Leave as-is unless you have a reason to change it. /endpoint/upload/ is the
# alias the reference client uses to dodge Cloudflare's per-IP rate limiting
# on /api/*; both routes accept the same envelope.
WDGWARS_API_URL=https://wdgwars.pl/endpoint/upload/

# How often to poll tar1090 and merge into the rolling "seen this window"
# set. This does NOT upload anything by itself.
POLL_INTERVAL_SECONDS=30

# How often the accumulated set is actually uploaded, in hours.
UPLOAD_INTERVAL_HOURS=6

# How many upload snapshots to keep on disk before pruning the oldest.
SNAPSHOT_RETENTION=200

# Overwrite /data/latest_raw.json with the most recent raw poll each time,
# for live debugging. Not part of the retention system (single file).
SAVE_LATEST_RAW=true

# Web Dashboard & MeshMapper API configuration
WEB_ENABLED=true
WEB_PORT=8080

# Set true to log what would be uploaded without actually POSTing anything.
# Good for the first run.
DRY_RUN=false

# Set true to poll once, force an immediate upload of whatever was seen,
# then exit. Useful for testing — normal operation should leave this false.
RUN_ONCE=false

LOG_LEVEL=INFO
